# ==============================================================================
# ReRun Autonomous Coding Platform - Environment Configuration
# ==============================================================================

# Application Basics
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL for Docker Compose, SQLite for Local Standalone)
DATABASE_URL=sqlite+aiosqlite:///./rerun.db
# DATABASE_URL=postgresql+asyncpg://rerun:rerun_secret_password@localhost:5432/rerun_db

# LLM Provider Configuration (mock, openai, gemini, or ollama)
LLM_PROVIDER=mock
LLM_MODEL=heuristic-mock
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Sandbox Security and Resource Policy
MAX_EXECUTION_TIME=30
MAX_TOTAL_TASK_TIME=180
MAX_MEMORY_MB=512
MAX_CPU_CORES=1.0
MAX_OUTPUT_SIZE_BYTES=524288
MAX_RETRIES=3
REPEATED_FAILURE_THRESHOLD=2
NETWORK_POLICY=DISABLED

# Primary Docker Sandbox & Testing Fallback
DOCKER_IMAGE=rerun-sandbox:latest
ALLOW_LOCAL_FALLBACK_FOR_TESTING=true

# Concurrency
MAX_CONCURRENT_TASKS=4
